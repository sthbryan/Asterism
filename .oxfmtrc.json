{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "useTabs": false,
  "tabWidth": 2,
  "printWidth": 80,
  "singleQuote": false,
  "jsxSingleQuote": false,
  "quoteProps": "as-needed",
  "trailingComma": "all",
  "semi": true,
  "arrowParens": "always",
  "bracketSameLine": false,
  "bracketSpacing": true,
  "sortImports": {
    "newlinesBetween": false,
    "sortSideEffects": false
  },
  "sortPackageJson": false,
  "ignorePatterns": [
    "dist",
    "node_modules",
    "src-tauri",
    ".logs",
    "**/*.md",
    "**/*.yml",
    "**/*.yaml"
  ]
}
