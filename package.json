{
  "name": "asterism",
  "private": true,
  "version": "1.2.0",
  "packageManager": "bun@1.4.2",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "macos": "tauri dev",
    "preview": "vite preview",
    "tauri": "tauri",
    "icons": "bun assets/brand/generate-icon.mjs && bunx tauri icon assets/brand/asterism-icon.svg",
    "release": "bun scripts/release.mjs",
    "check": "oxlint --max-warnings=0 . && oxfmt --check .",
    "test:spacing": "bun scripts/check-spacing.mjs",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "prepare": "lefthook install"
  },
  "dependencies": {
    "@fontsource-variable/geist": "5.3.0",
    "@fontsource-variable/geist-mono": "5.3.0",
    "@phosphor-icons/react": "2.1.10",
    "@tailwindcss/vite": "4.3.3",
    "@tauri-apps/api": "2",
    "@tauri-apps/plugin-dialog": "2",
    "@tauri-apps/plugin-opener": "2",
    "@zovaris/sephiro": "0.12.1",
    "cn": "^0.4.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-if": "^4.1.6",
    "tailwindcss": "4.3.3",
    "virtua": "^0.51.3",
    "wouter": "^3.13.0",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@tauri-apps/cli": "2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "lefthook": "^2.2.2",
    "oxfmt": "^0.74.0",
    "oxlint": "^1.89.0",
    "playwright": "^1.64.1",
    "typescript": "~7.0.2",
    "vite": "8.3.0"
  }
}
